# Copy to .env (`cp .env.example .env`) to customize the Docker Compose
# stack. `docker compose up -d` works with no .env at all — every variable
# below has a sensible default baked into docker-compose.yml. Never commit
# a real .env or production secrets.

# --- PostgreSQL ---
POSTGRES_DB=municipal_gis
POSTGRES_USER=municipal_gis
POSTGRES_PASSWORD=municipal_gis_dev_password
# Host port Postgres is published on. Change if 5432 is already taken by a
# local Postgres install.
POSTGRES_PORT=5432

# --- Backend (NestJS, only used by the `backend` compose service) ---
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Keycloak ---
# Browser-facing URL — must match what Angular uses (see
# docs/keycloak-auth.md). Host port 8180 is mapped to the container's 8080.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=municipal-gis
KEYCLOAK_FRONTEND_CLIENT_ID=municipal-gis-frontend

# Confidential service-account client the backend uses for the Keycloak
# Admin API during municipality registration (see
# keycloak/import/municipal-gis-realm.json). This secret is committed there
# only because it is a local dev-only realm import, mirroring the existing
# admin/admin bootstrap credentials below — change both before any real
# deployment. NOTE: if you change this value here, you must also update the
# matching "secret" field in keycloak/import/municipal-gis-realm.json (the
# realm import does not read this .env file) and re-import the realm.
KEYCLOAK_ADMIN_CLIENT_ID=municipal-gis-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-backend-client-secret-change-me

# Dev-only bootstrap admin credentials for the Keycloak Admin Console.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- GeoServer ---
# Admin REST API credentials — used only by the backend (server-side),
# never exposed to Angular. Host port 8600 is mapped to the container's
# 8080 (change GEOSERVER_PORT if already taken).
GEOSERVER_PORT=8600
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver_dev_admin
# Stable extensions kartoza downloads on container start (needs internet,
# one-time). `ysld-plugin` is required for GIS Layer Styling — GeoServer
# stores the app-authored styles as YSLD. Comma-separated for more.
GEOSERVER_STABLE_EXTENSIONS=ysld-plugin

# --- MapFish Print (GIS "Print Layout") ---
# The mapfish-print container adds ~1 GB RAM to the stack. Defaults in
# docker-compose.yml need no .env entry; override only to point the
# backend at a MapFish/GeoServer running elsewhere.
# MAPFISH_PRINT_URL=http://mapfish-print:8080/print
# MAPFISH_GEOSERVER_URL=http://geoserver:8080/geoserver
