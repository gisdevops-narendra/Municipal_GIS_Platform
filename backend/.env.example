# Copy this file to .env for local development (`cp .env.example .env`).
# Never commit a real .env file or production secrets.
#
# These defaults assume Postgres and Keycloak are reached at localhost, i.e.
# you are running `npm run start:dev` directly on the host while Postgres
# and Keycloak run via `docker compose up -d postgres keycloak` (see root
# docker-compose.yml). If you instead run the backend itself inside Docker
# Compose, the compose file overrides these with container-network hostnames.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=municipal_gis
POSTGRES_USER=municipal_gis
POSTGRES_PASSWORD=municipal_gis_dev_password

# Prisma reads DATABASE_URL directly. Keep it consistent with the
# POSTGRES_* values above.
DATABASE_URL=postgresql://municipal_gis:municipal_gis_dev_password@localhost:5432/municipal_gis?schema=public

# --- Backend server ---
BACKEND_PORT=3000
# Origin allowed to call this API from the browser (the Angular dev server).
CORS_ORIGIN=http://localhost:4200

# --- Keycloak (token validation) ---
# Browser-facing base URL of the Keycloak server — this is what Keycloak
# stamps into every token's `iss` claim, so it MUST match the origin
# Angular actually authenticates against. Leave as-is for the default dev
# setup (Keycloak reached at localhost:8180 by both the browser and this
# backend running on the host).
KEYCLOAK_URL=http://localhost:8180
# Optional: where THIS backend process actually reaches Keycloak over the
# network, if different from KEYCLOAK_URL (e.g. running the backend itself
# inside Docker Compose, where Keycloak is reachable as
# `http://keycloak:8080` but the browser still uses localhost:8180).
# Defaults to KEYCLOAK_URL when unset — leave commented out for the
# `npm run start:dev` on host workflow.
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=municipal-gis
# The public SPA client ID Angular authenticates with. Used to check the
# token's authorized-party (azp) claim, since the default Keycloak access
# token audience is not client-specific for public clients.
KEYCLOAK_FRONTEND_CLIENT_ID=municipal-gis-frontend

# --- Keycloak Admin API (server-side only, used to create users during
# municipality registration) ---
# Confidential client with serviceAccountsEnabled + realm-management
# "manage-users" role, defined in keycloak/import/municipal-gis-realm.json.
# This secret must NEVER be exposed to Angular/the browser.
KEYCLOAK_ADMIN_CLIENT_ID=municipal-gis-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-backend-client-secret-change-me

# --- GeoServer (Task 5) ---
# REST Admin API — server-side only, never exposed to Angular. Assumes
# GeoServer reached via `docker compose up -d geoserver` published on the
# host at localhost:8600 (see root docker-compose.yml GEOSERVER_PORT).
GEOSERVER_URL=http://localhost:8600/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver_dev_admin

# --- PostGIS connection parameters for GeoServer datastores ---
# Same physical database as DATABASE_URL above — passed discretely because
# GeoServer's REST API wants each parameter separately, not a connection
# string. See docs/backend.md §19.
#
# IMPORTANT: unlike DATABASE_URL/POSTGRES_HOST above, this is the address
# GeoServer itself must use to reach Postgres — not this backend process.
# GeoServer always runs inside Docker Compose (there is no standalone
# GeoServer dev workflow), so this must stay the compose service name
# `postgres`, even when running the backend itself with `npm run start:dev`
# on the host. Do not change this to `localhost`.
POSTGIS_HOST=postgres
POSTGIS_PORT=5432
POSTGIS_DATABASE=municipal_gis
POSTGIS_USER=municipal_gis
POSTGIS_PASSWORD=municipal_gis_dev_password

# --- GIS uploads (Task 7) ---
# Local directory raw/temporary/processed upload files are stored under,
# organized per-municipality (see docs/backend.md "GIS Uploads" / "File
# storage"). Relative paths resolve against the backend process's cwd.
GIS_UPLOAD_STORAGE_DIR=./storage/uploads
# Configurable limits — never hard-coded in application code. All three
# are enforced server-side before any GDAL processing happens.
GIS_UPLOAD_MAX_FILE_SIZE_MB=500
GIS_UPLOAD_MAX_EXTRACTED_ZIP_SIZE_MB=2000
GIS_UPLOAD_MAX_ZIP_FILE_COUNT=100

# --- MapFish Print (GIS workspace "Print Layout" tool) ---
# MAPFISH_PRINT_URL: how THIS backend reaches the print engine.
# MAPFISH_GEOSERVER_URL: the GeoServer URL baked INTO the print spec, i.e.
#   how the mapfish-print CONTAINER reaches GeoServer — always the
#   compose-internal address, never the browser-facing localhost:8600
#   (same reasoning as POSTGIS_HOST above). Both the print engine and
#   GeoServer only run inside Docker Compose, so if you run this backend
#   on the host with `npm run start:dev`, point MAPFISH_PRINT_URL at a
#   published mapfish-print port and leave MAPFISH_GEOSERVER_URL as-is.
MAPFISH_PRINT_URL=http://localhost:8680/print
MAPFISH_PRINT_APP=municipal-gis
MAPFISH_GEOSERVER_URL=http://geoserver:8080/geoserver

# --- Demo layers ---
# When "true", every newly provisioned municipality is seeded with three
# sample layers (Municipality Boundary / Wards / Roads) backed by the
# hand-authored data in backend/prisma/seed-demo-gis-data.ts. Off by
# default so a fresh registration starts with an empty layer list until
# the owner uploads real data. Handy for local demos / screenshots.
GIS_SEED_DEMO_LAYERS=false
