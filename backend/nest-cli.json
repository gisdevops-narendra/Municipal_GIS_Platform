{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      { "include": "gis/marker-icons/*.svg", "outDir": "dist/src" },
      { "include": "gis/marker-icons/*.json", "outDir": "dist/src" },
      { "include": "gis/marker-icons/LICENSE.txt", "outDir": "dist/src" }
    ],
    "watchAssets": true
  }
}
