{
  "realm": "municipal-gis",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@municipal-gis.local",
    "fromDisplayName": "Municipal GIS Platform",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "municipal-gis-frontend",
      "name": "Municipal GIS Platform (Angular SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "municipal-gis-backend",
      "name": "Municipal GIS Platform (NestJS backend service account)",
      "description": "Confidential client used server-side only by the NestJS backend to call the Keycloak Admin API when registering a new municipality owner. Never used by, or exposed to, Angular.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-backend-client-secret-change-me"
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@municipal-gis.dev",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Test@1234",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-municipal-gis-backend",
      "enabled": true,
      "serviceAccountClientId": "municipal-gis-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
